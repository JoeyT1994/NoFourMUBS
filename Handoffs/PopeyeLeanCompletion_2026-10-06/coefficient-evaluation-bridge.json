    "native_reference": {
      "file": "reference/signed_linear_engine.cpp",
      "source_sha256": "e24f26513193f267e85b9b40f8251dc6910ed234fefcd258c12e4a64e1b100fb",
      "repository_source": "mub6-numerical/runs/popeye-ring-2026-10-04.nosync/engine/signed_linear_engine.cpp",
      "comparison": "stableRFormula reproduces the exact arithmetic operations of native stableR in an arbitrary commutative ring; nativeStableR specializes to real numbers. Real algebra does not verify the native C++ execution."
    },
    "reused_checked_results": [
      "Centiradian20261006.invariant_expansion in CentiradianArithmetic, prior check-arithmetic-04",
      "Centiradian20261006.dephased_leadingR in CentiradianPhysical, prior check-physical-03",
      "Centiradian20261006.SignedDeterminant.cast_gramP, cast_gramJ, cast_gramW in SignedDeterminantGram, prior check-gram-02",
      "The frozen 61-theorem physical-native-signed-mean coefficient bridge, with source-pinned dependency copies"
    ],
    "formal_results": [
      "nativeStableR_eq_invariant proves the exact real native stableR polynomial equals the established invariant formula.",
      "stableRFormula_gram proves the literal complex native formula at pComplex/jComplex/wComplex is exactly the cast of gramInvariant; it is not merely an equality of real parts.",
      "meanStableA_eq_real_formula and meanStableA_is_real prove the native stableA complex arithmetic equals the intended real formula at real z.",
      "exactSeedR_physical_seed proves exactSeedR(seedEntry H)=leadingR H from Dephased H alone; stableRFormula_physical_seed proves its complex arithmetic version.",
      "ExactSeedEvaluator defines A,beta,Delta,D,Kminus,Kplus,Hminus,Hplus directly on four complex seed entries and the native three-pair order, then proves each output meaning on actual dephased H.",
      "exact_seed_sign_square and exact_seed_mean_abs_bound connect the matrix-free evaluator to the actual physical side sign and necessary mean inequality.",
      "phaseSeed_re, phaseSeed_im and phaseSeed_unit bind exp(I*theta) to exact cosine/sine unit phases.",
      "punctured_seed_evaluator_lift extracts the original exact angular lift from InPuncturedSeedBall, preserving its radius and nonzero displacement, and proves evaluator values equal the actual physical quantities."
    ],
    "api_namespace": "Centiradian20261006.NativeEvaluation20261006",
