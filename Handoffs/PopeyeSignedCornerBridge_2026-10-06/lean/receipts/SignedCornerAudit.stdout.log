def Centiradian20261006.Physical : Centiradian20261006.Mat6 → Prop :=
fun H =>
  (∀ (i j : Fin 6), Complex.normSq (H i j) = 1) ∧
    ∀ (i j : Fin 6), ∑ k, H i k * (starRingEnd ℂ) (H j k) = if i = j then 6 else 0
def Centiradian20261006.Maximal : Centiradian20261006.Mat6 → Prop :=
fun H =>
  ∀ (a b c : Fin 6),
    a < b →
      b < c →
        ∀ (C : Finset (Fin 6)), C.card = 3 → Centiradian20261006.cornerR H a b c C ≤ Centiradian20261006.leadingR H
def Centiradian20261006.SignedDeterminant.cornerSigned : Centiradian20261006.Mat6 →
  Fin 6 → Fin 6 → Fin 6 → Fin 6 → Fin 6 → Fin 6 → ℝ :=
fun H r₀ r₁ r₂ c₀ c₁ c₂ =>
  have N := Centiradian20261006.SignedDeterminant.cornerNormalize H r₀ c₀;
  Centiradian20261006.SignedDeterminant.fastSigned (N r₁ c₁) (N r₁ c₂) (N r₂ c₁) (N r₂ c₂)
Centiradian20261006.SignedDeterminant.cornerNormalize_eq_source_dephasing (H : Centiradian20261006.Mat6)
  (r c i j : Fin 6) :
  Centiradian20261006.SignedDeterminant.cornerNormalize H r c i j =
    H i j * H r c * (starRingEnd ℂ) (H i c) * (starRingEnd ℂ) (H r j)
Centiradian20261006.SignedDeterminant.complex_algebra_identity (a b c d : ℂ) (ha : Complex.normSq a = 1)
  (hb : Complex.normSq b = 1) (hc : Complex.normSq c = 1) (hd : Complex.normSq d = 1) :
  4 *
          (27 -
                3 *
                  Centiradian20261006.SignedDeterminant.pComplex (-1 - a - b) (-1 - c - d)
                    (-1 - c * (starRingEnd ℂ) a - d * (starRingEnd ℂ) b) -
              Centiradian20261006.SignedDeterminant.jComplex (-1 - a - b) (-1 - c - d)
                (-1 - c * (starRingEnd ℂ) a - d * (starRingEnd ℂ) b)) ^
            2 *
        (9 -
            Centiradian20261006.SignedDeterminant.pComplex (-1 - a - b) (-1 - c - d)
              (-1 - c * (starRingEnd ℂ) a - d * (starRingEnd ℂ) b) -
          Centiradian20261006.SignedDeterminant.jComplex (-1 - a - b) (-1 - c - d)
            (-1 - c * (starRingEnd ℂ) a - d * (starRingEnd ℂ) b)) -
      (Centiradian20261006.SignedDeterminant.wComplex (-1 - a - b) (-1 - c - d)
              (-1 - c * (starRingEnd ℂ) a - d * (starRingEnd ℂ) b) -
            (Centiradian20261006.SignedDeterminant.pComplex (-1 - a - b) (-1 - c - d)
                  (-1 - c * (starRingEnd ℂ) a - d * (starRingEnd ℂ) b) -
                9) *
              (Centiradian20261006.SignedDeterminant.pComplex (-1 - a - b) (-1 - c - d)
                  (-1 - c * (starRingEnd ℂ) a - d * (starRingEnd ℂ) b) -
                18) -
          (Centiradian20261006.SignedDeterminant.pComplex (-1 - a - b) (-1 - c - d)
                (-1 - c * (starRingEnd ℂ) a - d * (starRingEnd ℂ) b) -
              15) *
            Centiradian20261006.SignedDeterminant.jComplex (-1 - a - b) (-1 - c - d)
              (-1 - c * (starRingEnd ℂ) a - d * (starRingEnd ℂ) b)) ^
        2 =
    -Centiradian20261006.SignedDeterminant.rawDet a b c d ^ 2
Centiradian20261006.SignedDeterminant.complementary_invariant_eq_signed_square (a b c d : ℂ) (ha : Complex.normSq a = 1)
  (hb : Complex.normSq b = 1) (hc : Complex.normSq c = 1) (hd : Complex.normSq d = 1) :
  Centiradian20261006.invariant
      (Centiradian20261006.gramP (-1 - a - b) (-1 - c - d) (-1 - c * (starRingEnd ℂ) a - d * (starRingEnd ℂ) b))
      (-Centiradian20261006.gramJ (-1 - a - b) (-1 - c - d) (-1 - c * (starRingEnd ℂ) a - d * (starRingEnd ℂ) b))
      (Centiradian20261006.gramW (-1 - a - b) (-1 - c - d) (-1 - c * (starRingEnd ℂ) a - d * (starRingEnd ℂ) b)) =
    Centiradian20261006.SignedDeterminant.fastSigned a b c d ^ 2
Centiradian20261006.SignedDeterminant.physical_signed_square_complement {H : Centiradian20261006.Mat6}
  (hH : Centiradian20261006.Physical H) (r₀ r₁ r₂ c₀ c₁ c₂ : Fin 6) (hr₀₁ : r₀ < r₁) (hr₁₂ : r₁ < r₂) (hc₀₁ : c₀ < c₁)
  (hc₁₂ : c₁ < c₂) :
  Centiradian20261006.SignedDeterminant.cornerSigned H r₀ r₁ r₂ c₀ c₁ c₂ ^ 2 =
    Centiradian20261006.cornerR H r₀ r₁ r₂ {c₀, c₁, c₂}ᶜ
Centiradian20261006.SignedDeterminant.physical_maximal_signed_square_bound {H : Centiradian20261006.Mat6}
  (hH : Centiradian20261006.Physical H) (hm : Centiradian20261006.Maximal H) (r₀ r₁ r₂ c₀ c₁ c₂ : Fin 6)
  (hr₀₁ : r₀ < r₁) (hr₁₂ : r₁ < r₂) (hc₀₁ : c₀ < c₁) (hc₁₂ : c₁ < c₂) :
  Centiradian20261006.SignedDeterminant.cornerSigned H r₀ r₁ r₂ c₀ c₁ c₂ ^ 2 ≤ Centiradian20261006.leadingR H
Centiradian20261006.SignedDeterminant.physical_maximal_signed_abs_bound {H : Centiradian20261006.Mat6}
  (hH : Centiradian20261006.Physical H) (hm : Centiradian20261006.Maximal H) (hR : 0 < Centiradian20261006.leadingR H)
  (r₀ r₁ r₂ c₀ c₁ c₂ : Fin 6) (hr₀₁ : r₀ < r₁) (hr₁₂ : r₁ < r₂) (hc₀₁ : c₀ < c₁) (hc₁₂ : c₁ < c₂) :
  |Centiradian20261006.SignedDeterminant.cornerSigned H r₀ r₁ r₂ c₀ c₁ c₂| ≤ √(Centiradian20261006.leadingR H)
