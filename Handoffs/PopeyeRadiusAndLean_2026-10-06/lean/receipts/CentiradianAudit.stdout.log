Centiradian20261006.CentiradianExclusion : Prop
def Centiradian20261006.CentiradianExclusion : Prop :=
∀ (H : Centiradian20261006.Mat6),
  Centiradian20261006.Physical H →
    Centiradian20261006.Dephased H →
      Centiradian20261006.Maximal H →
        0 < Centiradian20261006.leadingR H →
          ∀ (conjugateSeed : Bool), Centiradian20261006.InPuncturedSeedBall H conjugateSeed (1 / 100) → False
