oof/independent/results_v3_fresh/step4.tsv","status":"added","additions":12022,"deletions":0,"changes":12022,"blob_url":"https://github.com/JoeyT1994/NoFourMUBS/blob/3a79a98fb3792ba9f4470a209123ac90c4ba23d1/proof%2Findependent%2Fresults_v3_fresh%2Fstep4.tsv","raw_url":"https://github.com/JoeyT1994/NoFourMUBS/raw/3a79a98fb3792ba9f4470a209123ac90c4ba23d1/proof%2Findependent%2Fresults_v3_fresh%2Fstep4.tsv","contents_url":"https://api.github.com/repos/JoeyT1994/NoFourMUBS/contents/proof%2Findependent%2Fresults_v3_fresh%2Fstep4.tsv?ref=3a79a98fb3792ba9f4470a209123ac90c4ba23d1"},{"sha":"abb7511269e83be6ca8c883a4f7d60d92a078d0a","filename":"proof/independent/run_rusty.sh","status":"added","additions":19,"deletions":0,"changes":19,"blob_url":"https://github.com/JoeyT1994/NoFourMUBS/blob/3a79a98fb3792ba9f4470a209123ac90c4ba23d1/proof%2Findependent%2Frun_rusty.sh","raw_url":"https://github.com/JoeyT1994/NoFourMUBS/raw/3a79a98fb3792ba9f4470a209123ac90c4ba23d1/proof%2Findependent%2Frun_rusty.sh","contents_url":"https://api.github.com/repos/JoeyT1994/NoFourMUBS/contents/proof%2Findependent%2Frun_rusty.sh?ref=3a79a98fb3792ba9f4470a209123ac90c4ba23d1","patch":"@@ -0,0 +1,19 @@\n+#!/bin/bash\n+#SBATCH -J nofour_indep_v3\n+#SBATCH -p gen\n+#SBATCH -N 1\n+#SBATCH --exclusive\n+#SBATCH -t 1-00:00:00\n+#SBATCH -o out/indep_%j.log\n+# Fresh, complete independent check (Steps 3, 4 and F6 nonemptiness) of the v3 atlas certificate.\n+set -u\n+cd \"$SLURM_SUBMIT_DIR\"\n+NT=${SLURM_CPUS_ON_NODE:-$(nproc)}\n+echo \"=== host $(hostname)  threads $NT  $(date)\"\n+sha256sum atlas_certificate.json.gz\n+rm -rf out/fresh && mkdir -p out/fresh\n+julia --startup-file=no -t $NT --project=jlenv check.jl atlas_certificate.json.gz out/fresh\n+echo \"=== check exit $? $(date)\"\n+julia --startup-file=no --project=jlenv tests/sanity.jl out/fresh/certificate.txt\n+echo \"=== sanity exit $? $(date)\"\n+grep -E \"SUMMARY|VERDICT\" out/fresh/RESULT.txt"},{"sha":"d114c6678e37e6a3f7bdd60f6bc2b263a4ce3860","filename":"proof/independent/src/boundary.jl","status":"modified","additions":7,"deletions":2,"changes":9,"blob_url":"https://github.com/JoeyT1994/NoFourMUBS/blob/3a79a98fb3792ba9f4470a209123ac90c4ba23d1/proof%2Findependent%2Fsrc%2Fboundary.jl","raw_url":"https://github.com/JoeyT1994/NoFourMUBS/raw/3a79a98fb3792ba9f4470a209123ac90c4ba23d1/proof%2Findependent%2Fsrc%2Fboundary.jl","contents_url":"https://api.github.com/repos/JoeyT1994/NoFourMUBS/contents/proof%2Findependent%2Fsrc%2Fboundary.jl?ref=3a79a98fb3792ba9f4470a209123ac90c4ba23d1","patch":"@@ -201,7 +201,9 @@ function nonempty_F6(recs::Vector{Rec}, cands::Vector{Int})\n     F6f = F6k .* (2π / 6)\n     perms = permutations6()\n     results = []\n-    for ti in cands\n+    lk = ReentrantLock()\n+    # Threaded over candidate records: only the search is parallel; each acceptance is the interval test below.\n+    Threads.@threads :dynamic for ti in cands\n         P = recs[ti].P\n         # quick filter: dephased phases close to multiples of 2 pi/6\n         Y = [P[j, k] - P[j, 1] - P[1, k] + P[1, 1] for j in 1:6, k in 1:6]\n@@ -226,7 +228,10 @@ function nonempty_F6(recs::Vector{Rec}, cands::Vector{Int})\n         Di = [AFi[j, k] - iv(P[j, k]) + TWOPI_I * iv(N[j, k]) for j in 1:6, k in 1:6]\n         c = hproj(Di)\n         d = sqrt(sum(x^2 for x in c))\n-        push!(results, (ti - 1, sup(d), recs[ti].R, sup(d) < recs[ti].R, sign, tr, rp .- 1, cp .- 1))\n+        lock(lk) do\n+            push!(results, (ti - 1, sup(d), recs[ti].R, sup(d) < recs[ti].R, sign, tr, rp .- 1, cp .- 1))\n+        end\n     end\n+    sort!(results, by = x -> x[1])\n     results\n end"}]}