    (hrep : ∀ i : Fin 32, CoveredState d0Tables (toCarrier R carrier) T R targets
      (signsOf (chosenRepresentative i)) rootState) :
    ∀ i : Fin 32, CoveredState d0Tables (toCarrier R carrier) T R targets
      (signsOf i) rootState := by
  intro i
  have hr := hrep i
  rw [← chart_route i] at hr
  exact covered_root_unpermute (rowPerm (chosenPermutation i))
    (targetPerm (chosenPermutation i)) (carrier_preserved _)
    (targets_permuted _) (signsOf i) hr

