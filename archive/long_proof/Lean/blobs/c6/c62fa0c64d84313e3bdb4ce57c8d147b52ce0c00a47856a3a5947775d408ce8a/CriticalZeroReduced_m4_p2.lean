/-- The same reduced moment, now connected to both complete reconstructed
sides and their actual Newton formulas. -/
theorem reduced_m4_p2 (X Y z r : ℂ)
    (hX : X≠0) (hY : Y≠0) (hz : z≠0) (hDx : X-3*z-9≠0)
    (hDy : Y-3*z-9≠0) (hDz : X+Y+z^2+3*z≠0)
    (hq : Y*r^2= -X*(9-z^2-X-Y)) :
    newton_m4_p2 (zeroSide X Y z r 1)+newton_m4_p2 (zeroSide X Y z r (-1)) =
      reducedNumerator_m4_p2 X Y z r / reducedDenominator_m4_p2 X Y z r := by
  rw [raw_m4_p2 X Y z r hX hz hDx hDy hDz]
  exact quadratic_m4_p2 X Y z r hX hY hz hDx hDy hDz hq
end
