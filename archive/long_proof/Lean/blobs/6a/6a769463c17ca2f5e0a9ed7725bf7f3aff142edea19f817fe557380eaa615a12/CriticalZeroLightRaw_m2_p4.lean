/-- Exact rational normalization before any quadratic or splitting relation.
All denominators are guarded explicitly. -/
theorem raw_m2_p4 (X Y z r : K)
    (hX : X≠0) (hz : z≠0) (hDx : X-3*z-9≠0)
    (hDy : Y-3*z-9≠0) (hDz : X+Y+z^2+3*z≠0) :
    newton_m2_p4 (zeroSide X Y z r 1)+newton_m2_p4 (zeroSide X Y z r (-1)) =
      numerator_m2_p4 X Y z r / denominator_m2_p4 X Y z r := by
  dsimp only [zeroSide,reconstructionData,newton_m2_p4,numerator_m2_p4,denominator_m2_p4]
  field_simp [hX,hz,hDx,hDy,hDz]
  <;> ring
end
