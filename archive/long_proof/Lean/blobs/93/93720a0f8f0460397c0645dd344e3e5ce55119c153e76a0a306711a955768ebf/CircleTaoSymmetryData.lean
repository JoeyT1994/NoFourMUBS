theorem chart_route : ∀ i : Fin 32,
    permuteSigns (rowPerm (chosenPermutation i)) (signsOf i) =
      signsOf (chosenRepresentative i) := by
  decide +kernel

theorem all_roots_from_routed
    (hrep : ∀ i : Fin 32, CoveredState taoTables (toCarrier R carrier) T R targets
      (signsOf (chosenRepresentative i)) rootState) :
    ∀ i : Fin 32, CoveredState taoTables (toCarrier R carrier) T R targets
