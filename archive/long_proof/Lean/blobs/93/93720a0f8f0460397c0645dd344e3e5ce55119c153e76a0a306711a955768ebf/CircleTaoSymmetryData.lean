theorem rowTail_bijective : ∀ i : Fin 10, Function.Bijective (rowTail i) := by
  decide +kernel
theorem targetMap_bijective : ∀ i : Fin 10, Function.Bijective (targetMap i) := by
  decide +kernel
noncomputable def rowPerm (i : Fin 10) : Equiv.Perm (Fin 5) :=
  Equiv.ofBijective (rowTail i) (rowTail_bijective i)
noncomputable def targetPerm (i : Fin 10) : Equiv.Perm (Fin 90) :=
  Equiv.ofBijective (targetMap i) (targetMap_bijective i)

theorem carrier_preserved : ∀ i : Fin 10, ∀ r k : Fin 6,
    (toCarrier R carrier) r k =
      (toCarrier R carrier) (extendTail (rowPerm i) r) (extendTail (rowPerm i) k) := by
  decide +kernel
theorem targets_permuted : ∀ i : Fin 10, ∀ v : Fin 90, ∀ j : Fin 5,
    targets (targetPerm i v) j = targets v (rowPerm i j) := by
  decide +kernel

