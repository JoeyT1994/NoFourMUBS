/-- Split the high-degree polynomial proof from the later division step. -/
theorem even_numerator_m2_m2 (X Y z r : K) :
    numerator_m2_m2 X Y z r=evenNumerator_m2_m2 X Y z (r^2) := by
  dsimp only [numerator_m2_m2,evenNumerator_m2_m2]
  ring

/-- Polynomial certificate for the quadratic reduction; no generic division
or numerical root assumption replaces the explicit complex relation. -/
theorem quadratic_m2_m2 (X Y z r : K)
    (hX : X≠0) (hY : Y≠0) (hz : z≠0) (hDx : X-3*z-9≠0)
    (hDy : Y-3*z-9≠0) (hDz : X+Y+z^2+3*z≠0)
    (hq : Y*r^2= -X*(9-z^2-X-Y)) :
    numerator_m2_m2 X Y z r / denominator_m2_m2 X Y z r =
      reducedNumerator_m2_m2 X Y z r / reducedDenominator_m2_m2 X Y z r := by
  have hr : r^2= -X*(9-z^2-X-Y)/Y := by
    apply (eq_div_iff hY).mpr
    simpa only [mul_comm] using hq
  rw [even_numerator_m2_m2,hr]
  dsimp only [evenNumerator_m2_m2,denominator_m2_m2,reducedNumerator_m2_m2,reducedDenominator_m2_m2]
  field_simp [hX,hY,hz,hDx,hDy,hDz]
  <;> ring

