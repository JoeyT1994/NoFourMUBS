import SignedDeterminantGram
import KernelCornerExpression

set_option autoImplicit false
set_option maxHeartbeats 1500000
namespace Centiradian20261006.InvariantBinding20261006
open scoped ComplexConjugate BigOperators Matrix
open NativeSigned20261006 ChartExtension20261006 ChartRadius0120261006 SignedDeterminant
noncomputable section

/-- The positive-J physical invariant in the exact factored operation order
used by the Laurent expression. No sign flip for a complementary corner is
introduced here. -/
theorem cast_positive_invariant (p J W : ℝ) :
    (invariant p J W : ℂ)=
      let g : ℂ := 27+ -(3*(p:ℂ))+(J:ℂ)
      let eta : ℂ := 9+ -(p:ℂ)+(J:ℂ)
      let chi : ℂ := (W:ℂ)+ -(((p:ℂ)+ -9)*((p:ℂ)+ -18))+((p:ℂ)+ -15)*(J:ℂ)
      4*g*g*eta+ -(chi*chi) := by
  simp [invariant,pow_two,sub_eq_add_neg,mul_assoc]

/-- The root agent's actual KernelLaurent expression is exactly the complex
cast of the real physical Gram invariant, with the negative-Gram convention
and positive J. This equality does not need unit-entry assumptions. -/
theorem complexCornerR_eq_physical_invariant (a b c d : ℂ) :
    KernelLaurent.complexCornerR a b c d=
      (gramInvariant (-(1+(a+b))) (-(1+(c+d))) (-(1+(c*conj a+d*conj b))) : ℂ) := by
  rw [gramInvariant,cast_positive_invariant]
  simp only [cast_gramP,cast_gramJ,cast_gramW]
  simp only [KernelLaurent.complexCornerR,pComplex,jComplex,wComplex,sub_eq_add_neg]

/-- Actual leading-corner R equals the same positive-J complex expression.
Dephasing is the only premise; physicality and unit modulus are not silently
assumed for this algebraic identification. -/
theorem dephased_leadingR_eq_complexCornerR {H : Mat6} (hd : Dephased H) :
    (leadingR H : ℂ)=KernelLaurent.complexCornerR (H 1 1) (H 1 2) (H 2 1) (H 2 2) := by
  rw [dephased_leadingR hd,complexCornerR_eq_physical_invariant]
  have h (x y : ℂ) : -1-x-y= -(1+(x+y)) := by ring
  simp only [h]

theorem complexCornerR_im_zero (a b c d : ℂ) :
    (KernelLaurent.complexCornerR a b c d).im=0 := by
  rw [complexCornerR_eq_physical_invariant]
  rfl

/-- The auxiliary model's dephasing is exact for arbitrary four anchors and
arbitrary lower-block values generated by its totalized inverse. -/
theorem nativeChart_dephased (E : Mat3) (anchors : Fin 4 → ℂ)
    (hrow : ∀ j, E 0 j=1) (hcol : ∀ i, E i 0=1) : Dephased (nativeChart E anchors) := by
  constructor
  · intro j
    fin_cases j <;> simp [nativeChart,auxiliaryModel,assembleBlocks,constructedB,
      constructedC,constructedSideK,anchorTriple,hrow]
  · intro i
    fin_cases i <;> simp [nativeChart,auxiliaryModel,assembleBlocks,constructedB,
      constructedC,constructedSideK,anchorTriple,hcol]

theorem seed_nativeChart_leadingR_eq_complexCornerR (b : Bool) (u : Fin 4 → ℝ)
    (anchors : Fin 4 → ℂ) :
    (leadingR (nativeChart (seedCorner b u) anchors) : ℂ)=
      KernelLaurent.complexCornerR (phase (seedAngle b 0+u 0)) (phase (seedAngle b 1+u 1))
        (phase (seedAngle b 2+u 2)) (phase (seedAngle b 3+u 3)) := by
  have hrow : ∀ j, seedCorner b u 0 j=1 := by intro j; fin_cases j <;> simp [seedCorner]
  have hcol : ∀ i, seedCorner b u i 0=1 := by intro i; fin_cases i <;> simp [seedCorner]
  rw [dephased_leadingR_eq_complexCornerR (nativeChart_dephased _ _ hrow hcol)]
  rfl

/-- A phase-character basis monomial is the corresponding actual phase. -/
theorem kernel_phase_basis (θ : Fin 4 → ℝ) :
    KernelLaurent.phaseCharacter θ ⟨1,0,0,0⟩=phase (θ 0) ∧
    KernelLaurent.phaseCharacter θ ⟨0,1,0,0⟩=phase (θ 1) ∧
    KernelLaurent.phaseCharacter θ ⟨0,0,1,0⟩=phase (θ 2) ∧
    KernelLaurent.phaseCharacter θ ⟨0,0,0,1⟩=phase (θ 3) := by
  simp [KernelLaurent.phaseCharacter,KernelLaurent.phaseDot,phase]

/-- Direct physical-to-Laurent binding at the actual seed chart. The root's
2,083-coefficient table and subsequent Taylor bounds remain separate work. -/
theorem seed_nativeChart_leadingR_eq_laurent_eval (b : Bool) (u : Fin 4 → ℝ)
    (anchors : Fin 4 → ℂ) :
    (leadingR (nativeChart (seedCorner b u) anchors) : ℂ)=
      KernelLaurent.eval (KernelLaurent.phaseCharacter (fun i => seedAngle b i+u i))
        KernelLaurent.cornerPolynomial := by
  rw [KernelLaurent.eval_phase_cornerPolynomial]
  obtain ⟨h0,h1,h2,h3⟩ := kernel_phase_basis (fun i => seedAngle b i+u i)
  rw [h0,h1,h2,h3]
  exact seed_nativeChart_leadingR_eq_complexCornerR b u anchors

end
