theorem maximum_path_depth : maximumPathDepth = 20 := by decide +kernel

/-- Every generated representative tree covers its entire closed root box.
This is uniform over the 102 records; the record membership premise binds
the conclusion to the concrete generated radius-1/20 table. -/
theorem every_representative_closed_cover (record : RepresentativeCover)
    (hrecord : record ∈ allRepresentativeCovers)
    (B : Centiradian20261006.PhaseBox 4) (x : Fin 4 → Real)
    (hx : B.Contains x) :
    ∃ path kind, (path, kind) ∈ record.tree.paths ∧
      (follow B 0 path).Contains x := by
  exact record.tree.covers B 0 x hx

end
