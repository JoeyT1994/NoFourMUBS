  decide +kernel

theorem residualIm_sound (p : Variable → ℝ) (hp : ∀ i, Mem (boxes i) (p i)) :
    Mem residualImBox (evalReal p (residualPoly .vertical (-1/2 : ℚ) (1/3 : ℚ) 2).im) := by
  rw [← residualIm_box]
  exact enclose_polynomial boxes p hp residualIm _ residualIm_identity

