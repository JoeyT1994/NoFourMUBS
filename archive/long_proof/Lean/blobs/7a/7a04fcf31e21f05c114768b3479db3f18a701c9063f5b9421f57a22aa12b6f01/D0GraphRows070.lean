theorem orth_row_70 : ∀ j : Fin 120,
    IntegerIntervals.orthPossible 16 (zBoxes 70) (zBoxes j) = O 70 j := by
  decide +kernel
#print axioms orth_row_70
theorem unbiased_row_70 : ∀ j : Fin 120,
    IntegerIntervals.unbiasedPossible 16 (zBoxes 70) (zBoxes j) = U 70 j := by
  decide +kernel
#print axioms unbiased_row_70
