def credited (b : SeedBox) : Bool := b.sourceId == 6491830 || b.sourceId == 17434864
def residual : List SeedBox := incoming.filter fun b => !credited b

def piLo : ℚ := 314159265358979323846 / 100000000000000000000
def piHi : ℚ := 314159265358979323847 / 100000000000000000000
def seedLo (positive : Bool) : Fin 4 → ℚ :=
  if positive then ![0,0,2*piLo/3,-(2*piHi/3)] else ![0,0,-(2*piHi/3),2*piLo/3]
def seedHi (positive : Bool) : Fin 4 → ℚ :=
  if positive then ![0,0,2*piHi/3,-(2*piLo/3)] else ![0,0,-(2*piLo/3),2*piHi/3]
def phaseBound (b : SeedBox) (i : Fin 4) : ℚ := |b.center i|+radius

theorem incoming_length : incoming.length=38 := by decide +kernel
theorem incoming_ids_nodup : (incoming.map SeedBox.sourceId).Nodup := by decide +kernel
theorem credited_ids : ((incoming.filter credited).map SeedBox.sourceId)=[6491830,17434864] := by decide +kernel
theorem residual_length : residual.length=36 := by decide +kernel
theorem radius_positive : (0:ℚ)<radius := by decide +kernel
theorem radius_lt_one_over_2500 : radius<(1:ℚ)/2500 := by decide +kernel
theorem residual_root_bounds : ∀ b ∈ residual, ∀ i : Fin 4,
    -(4:ℚ) ≤ b.box.lower i ∧ b.box.upper i ≤ 4 := by decide +kernel
theorem residual_seed_bounds : ∀ b ∈ residual, ∀ i : Fin 4,
    seedHi b.positiveSeed i-1/650 ≤ b.box.lower i ∧
      b.box.upper i ≤ seedLo b.positiveSeed i+1/650 := by decide +kernel
theorem residual_first_pair_bound : ∀ b ∈ residual,
    2*((phaseBound b 0)^2+(phaseBound b 1)^2)<((1213:ℚ)/500000)^2 := by decide +kernel
theorem printed_cap_envelope : ∀ b ∈ residual,
    0 ≤ b.reportedCap ∧ b.reportedCap < (1:ℚ)/30000000 := by decide +kernel
theorem printed_cap_claim_false : ¬(∀ b ∈ residual, b.reportedCap ≤ (1:ℚ)/62500000) := by decide +kernel

