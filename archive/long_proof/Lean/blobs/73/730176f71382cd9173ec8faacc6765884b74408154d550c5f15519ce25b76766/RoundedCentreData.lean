def roundedCentreCheck : Bool := decide (∀i : Fin 48,∀j : Fin 5,
  |((roundedCentreCoordinates i j).1:ℚ)-67108864*(rationalCentre i j.succ).1|<1 ∧
  |((roundedCentreCoordinates i j).2:ℚ)-67108864*(rationalCentre i j.succ).2|<1)

theorem roundedCentreCheck_pass : roundedCentreCheck=true := by decide +kernel

theorem roundedCentre_coordinate_errors (i : Fin 48) (j : Fin 5) :
    |((roundedCentreCoordinates i j).1:ℝ)-67108864*(exactCentre i j.succ).re|<1 ∧
    |((roundedCentreCoordinates i j).2:ℝ)-67108864*(exactCentre i j.succ).im|<1 := by
  have hp : ∀i : Fin 48,∀j : Fin 5,
      |((roundedCentreCoordinates i j).1:ℚ)-67108864*(rationalCentre i j.succ).1|<1 ∧
      |((roundedCentreCoordinates i j).2:ℚ)-67108864*(rationalCentre i j.succ).2|<1 :=
    of_decide_eq_true roundedCentreCheck_pass
  constructor
  · change |((roundedCentreCoordinates i j).1:ℝ)-67108864*((rationalCentre i j.succ).1:ℝ)|<1
    exact_mod_cast (hp i j).1
  · change |((roundedCentreCoordinates i j).2:ℝ)-67108864*((rationalCentre i j.succ).2:ℝ)|<1
    exact_mod_cast (hp i j).2

noncomputable def roundedCentrePoint (i : Fin 48) (j : Fin 5) : ℂ :=
  ⟨((roundedCentreCoordinates i j).1:ℝ),((roundedCentreCoordinates i j).2:ℝ)⟩

theorem roundedCentre_complex_errors (i : Fin 48) (j : Fin 5) :
    |(roundedCentrePoint i j-(67108864:ℂ)*exactCentre i j.succ).re|<1 ∧
    |(roundedCentrePoint i j-(67108864:ℂ)*exactCentre i j.succ).im|<1 := by
  norm_num [roundedCentrePoint,Complex.mul_re,Complex.mul_im]
  exact roundedCentre_coordinate_errors i j

