def denominator_p4_m2 (X Y z r : K) : K := (1)*(X - 3*z - 9)*(X + Y + z^2 + 3*z)*(Y - 3*z - 9)^3*(z)^4*(X)^6

/-- Exact rational normalization before any quadratic or splitting relation.
All denominators are guarded explicitly. -/
theorem raw_p4_m2 (X Y z r : K)
    (hX : X≠0) (hz : z≠0) (hDx : X-3*z-9≠0)
    (hDy : Y-3*z-9≠0) (hDz : X+Y+z^2+3*z≠0) :
    newton_p4_m2 (zeroSide X Y z r 1)+newton_p4_m2 (zeroSide X Y z r (-1)) =
      numerator_p4_m2 X Y z r / denominator_p4_m2 X Y z r := by
  dsimp only [zeroSide,reconstructionData,newton_p4_m2,numerator_p4_m2,denominator_p4_m2]
  field_simp [hX,hz,hDx,hDy,hDz]
  <;> ring
end
