theorem cover_2552622 : CoveredState d0Tables (toCarrier R carrier) T R targets
    (signsOf (⟨30, by decide⟩ : Fin 32)) state_2552622 := by
  apply coveredState_of_hexJoined d0_image_sound d0_term_sound
    (fuel := 24) (count := 637) (hex := hex_2552622)
