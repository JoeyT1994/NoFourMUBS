theorem shift_checked : shiftCheck Centre2299.ball Jets2299.M Ball2299.P P Ball2299.V theta offset radius Ball2299.data.scalar.bounds.r sigma = true := by decide +kernel

theorem checked : ((wholeBallCheck Centre2299.ball Centre2299.centre Jets2299.M Ball2299.P Ball2299.V Ball2299.data) && (shiftCheck Centre2299.ball Jets2299.M Ball2299.P P Ball2299.V theta offset radius Ball2299.data.scalar.bounds.r sigma)) = true := by
  simp only [Bool.and_eq_true]
  exact ⟨Ball2299.checked, shift_checked⟩

