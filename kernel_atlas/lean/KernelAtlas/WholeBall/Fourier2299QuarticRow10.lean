namespace NoFourMUBs.KernelAtlas.WholeBall.Fourier2299

theorem quartic_10_0 :
    MatrixBox.enclosesBlockCheck (k := 7) (b := 5) ((data.fourier.K0.mul (polyQuarticReal.columns quarticPick)).add (data.fourier.K1.mul (polyQuarticImag.columns quarticPick))) (data.quartic.columns quarticPick) 10 0 = true := by decide +kernel

