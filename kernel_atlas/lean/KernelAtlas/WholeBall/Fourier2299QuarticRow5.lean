theorem quartic_row_5 (j : Fin 7) :
    MatrixBox.enclosesBlockCheck (k := 7) (b := 5) ((data.fourier.K0.mul (polyQuarticReal.columns quarticPick)).add (data.fourier.K1.mul (polyQuarticImag.columns quarticPick))) (data.quartic.columns quarticPick) 5 j = true := by
  fin_cases j
  · exact quartic_5_0
  · exact quartic_5_1
  · exact quartic_5_2
  · exact quartic_5_3
  · exact quartic_5_4
  · exact quartic_5_5
  · exact quartic_5_6

end NoFourMUBs.KernelAtlas.WholeBall.Fourier2299
