theorem quartic_row_7 (j : Fin 7) :
    MatrixBox.enclosesBlockCheck (k := 7) (b := 5) ((data.fourier.K0.mul (polyQuarticReal.columns quarticPick)).add (data.fourier.K1.mul (polyQuarticImag.columns quarticPick))) (data.quartic.columns quarticPick) 7 j = true := by
  fin_cases j
  · exact quartic_7_0
  · exact quartic_7_1
  · exact quartic_7_2
  · exact quartic_7_3
  · exact quartic_7_4
