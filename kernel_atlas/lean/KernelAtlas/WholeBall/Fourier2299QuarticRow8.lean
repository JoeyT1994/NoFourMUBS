theorem quartic_row_8 (j : Fin 7) :
    MatrixBox.enclosesBlockCheck (k := 7) (b := 5) ((data.fourier.K0.mul (polyQuarticReal.columns quarticPick)).add (data.fourier.K1.mul (polyQuarticImag.columns quarticPick))) (data.quartic.columns quarticPick) 8 j = true := by
  fin_cases j
  · exact quartic_8_0
  · exact quartic_8_1
  · exact quartic_8_2
  · exact quartic_8_3
  · exact quartic_8_4
  · exact quartic_8_5
  · exact quartic_8_6

