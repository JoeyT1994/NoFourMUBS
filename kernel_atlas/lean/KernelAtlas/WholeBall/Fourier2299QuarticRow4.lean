theorem quartic_row_4 (j : Fin 7) :
    MatrixBox.enclosesBlockCheck (k := 7) (b := 5) ((data.fourier.K0.mul (polyQuarticReal.columns quarticPick)).add (data.fourier.K1.mul (polyQuarticImag.columns quarticPick))) (data.quartic.columns quarticPick) 4 j = true := by
  fin_cases j
  · exact quartic_4_0
  · exact quartic_4_1
  · exact quartic_4_2
  · exact quartic_4_3
  · exact quartic_4_4
  · exact quartic_4_5
  · exact quartic_4_6

end NoFourMUBs.KernelAtlas.WholeBall.Fourier2299
