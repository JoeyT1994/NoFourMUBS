theorem quartic_row_16 (j : Fin 7) :
    MatrixBox.enclosesBlockCheck (k := 7) (b := 5) ((data.fourier.K0.mul (polyQuarticReal.columns quarticPick)).add (data.fourier.K1.mul (polyQuarticImag.columns quarticPick))) (data.quartic.columns quarticPick) 16 j = true := by
  fin_cases j
  · exact quartic_16_0
  · exact quartic_16_1
  · exact quartic_16_2
  · exact quartic_16_3
  · exact quartic_16_4
  · exact quartic_16_5
  · exact quartic_16_6

