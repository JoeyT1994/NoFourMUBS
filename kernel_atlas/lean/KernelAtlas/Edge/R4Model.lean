  have h_dZ := (has_add (has_mul hu (has_conj h_r) h_dr) (has_mul hu h_r (has_conj h_dr)))
  have h_p := (has_add (has_add h_X h_Yv) h_Z)
  have h_dp := (has_add h_dY h_dZ)
  have h_srt := (has_mul hu (has_mul hu h_s h_r) (has_conj h_t))
  have h_J := (has_add h_srt (has_conj h_srt))
  have h_dsrt := (has_add (has_mul hu (has_mul hu h_s h_dr) (has_conj h_t)) (has_mul hu (has_mul hu h_s h_r) (has_conj h_dt)))
  have h_dJ := (has_add h_dsrt (has_conj h_dsrt))
  have h_XY := (has_mul hu h_X h_Yv)
  have h_W := (has_sub (has_add (has_add h_XY (has_mul hu h_X h_Z)) (has_mul hu h_Yv h_Z)) (has_mul hu h_XY h_Z))
  have h_dW := (has_sub (has_add (has_add (has_add (has_mul hu h_X h_dY) (has_mul hu h_X h_dZ)) (has_mul hu h_dY h_Z)) (has_mul hu h_Yv h_dZ)) (has_mul hu h_X (has_add (has_mul hu h_dY h_Z) (has_mul hu h_Yv h_dZ))))
  have h_c3 := (has_grid_int u 3)
  have h_g := (has_add (has_sub (has_grid_int u 27) (has_mul hu h_c3 h_p)) h_J)
  have h_dg := (has_sub h_dJ (has_mul hu h_c3 h_dp))
  have h_eta := (has_add (has_sub (has_grid_int u 9) h_p) h_J)
  have h_deta := (has_sub h_dJ h_dp)
  have h_p9 := (has_sub h_p (has_grid_int u 9))
  have h_p15 := (has_sub h_p (has_grid_int u 15))
  have h_p18 := (has_sub h_p (has_grid_int u 18))
  have h_chi := (has_add (has_sub h_W (has_mul hu h_p9 h_p18)) (has_mul hu h_p15 h_J))
  have h_dchi := (has_add (has_add (has_sub (has_sub h_dW (has_mul hu h_dp h_p18)) (has_mul hu h_p9 h_dp)) (has_mul hu h_dp h_J)) (has_mul hu h_p15 h_dJ))
  have h_gg := (has_mul hu h_g h_g)
  have H := (has_sub (has_add (has_mul hu (has_grid_int u 8) (has_mul hu (has_mul hu h_g h_dg) h_eta)) (has_mul hu (has_grid_int u 4) (has_mul hu h_gg h_deta))) (has_mul hu (has_grid_int u 2) (has_mul hu h_chi h_dchi)))
  simpa only [dRT, dR4C, oneZ, one_mul, Int.cast_ofNat, Int.cast_one] using H

