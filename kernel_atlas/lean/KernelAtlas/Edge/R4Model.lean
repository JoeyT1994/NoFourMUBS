open Complex

noncomputable section

namespace NoFourMUBs.KernelAtlas.Edge

open Seed

/-- Exact evaluation of the fourth-angle derivative circuit. -/
def dR4C (a b c d : ℂ) : ℂ :=
  let one := (1 : ℂ)
  let s := (-((one + a) + b))
  let t := (-((one + c) + d))
  let r := (-((one + (c * ((starRingEnd ℂ) a))) + (d * ((starRingEnd ℂ) b))))
  let dt := (-(I * d))
  let dr := (-(I * (d * ((starRingEnd ℂ) b))))
  let X := (s * ((starRingEnd ℂ) s))
  let Yv := (t * ((starRingEnd ℂ) t))
  let Z := (r * ((starRingEnd ℂ) r))
  let dY := ((((starRingEnd ℂ) t) * dt) + (t * ((starRingEnd ℂ) dt)))
  let dZ := ((((starRingEnd ℂ) r) * dr) + (r * ((starRingEnd ℂ) dr)))
  let p := ((X + Yv) + Z)
  let dp := (dY + dZ)
  let srt := ((s * r) * ((starRingEnd ℂ) t))
  let J := (srt + ((starRingEnd ℂ) srt))
  let dsrt := (((s * dr) * ((starRingEnd ℂ) t)) + ((s * r) * ((starRingEnd ℂ) dt)))
  let dJ := (dsrt + ((starRingEnd ℂ) dsrt))
  let XY := (X * Yv)
  let W := (((XY + (X * Z)) + (Yv * Z)) - (XY * Z))
  let dW := (((((X * dY) + (X * dZ)) + (dY * Z)) + (Yv * dZ)) - (X * ((dY * Z) + (Yv * dZ))))
  let c3 := (3 : ℂ)
  let g := (((27 : ℂ) - (c3 * p)) + J)
  let dg := (dJ - (c3 * dp))
  let eta := (((9 : ℂ) - p) + J)
  let deta := (dJ - dp)
  let p9 := (p - (9 : ℂ))
  let p15 := (p - (15 : ℂ))
  let p18 := (p - (18 : ℂ))
  let chi := ((W - (p9 * p18)) + (p15 * J))
  let dchi := ((((dW - (dp * p18)) - (p9 * dp)) + (dp * J)) + (p15 * dJ))
  let gg := (g * g)
  ((((8 : ℂ) * ((g * dg) * eta)) + ((4 : ℂ) * (gg * deta))) - ((2 : ℂ) * (chi * dchi)))

lemma has_grid_int (u : Fin 4 → ℝ) (n : ℤ) :
    (const (n * 2 ^ pp, 0)).Has u (n : ℂ) := by
  have H := has_const (wT n) u
  rw [cz_wT] at H
  exact H

set_option maxHeartbeats 2000000 in
/-- Every model operation in `dRT` encloses the corresponding circuit value. -/
theorem has_dRT {h : List ℕ} {u : Fin 4 → ℝ} (hu : InBox h u)
    {a b c d : CT} {ar br cr dr : ℂ}
    (h_a : a.Has u ar) (h_b : b.Has u br) (h_c : c.Has u cr) (h_d : d.Has u dr) :
    (dRT h a b c d).Has u (dR4C ar br cr dr) := by
  have h_one := (has_grid_int u 1)
  have h_s := (has_neg (has_add (has_add h_one h_a) h_b))
  have h_t := (has_neg (has_add (has_add h_one h_c) h_d))
  have h_r := (has_neg (has_add (has_add h_one (has_mul hu h_c (has_conj h_a))) (has_mul hu h_d (has_conj h_b))))
  have h_dt := (has_neg (has_mulI h_d))
  have h_dr := (has_neg (has_mulI (has_mul hu h_d (has_conj h_b))))
  have h_X := (has_mul hu h_s (has_conj h_s))
  have h_Yv := (has_mul hu h_t (has_conj h_t))
  have h_Z := (has_mul hu h_r (has_conj h_r))
