import KernelAtlas.RecTao.LabelData
import KernelAtlas.StageCK
import KernelAtlas.Pack

/-! Record Tao: the O/U label graph from the direct edge tests (190 O pairs, 3912 U arcs; generated), and the
two-clique search (655 calls in the mirror). -/

namespace NoFourMUBs.KernelAtlas.RecTao

open NoFourMUBs.KernelAtlas

noncomputable def oRows : List ℕ := unpackL 89 90 

noncomputable def uRows : List ℕ := unpackL 90 90 

noncomputable def oR (i : ℕ) : ℕ := oRows.getD i 0
noncomputable def uR (i : ℕ) : ℕ := uRows.getD i 0

theorem labsSmall_ : labsSmall labs = true := by decide +kernel

theorem edgesOK_ : edgesOK tab pq labs oR uR = true := by decide +kernel

theorem cliqueOK_ : noTwo labs.length oR uR = true := by decide +kernel

end NoFourMUBs.KernelAtlas.RecTao
