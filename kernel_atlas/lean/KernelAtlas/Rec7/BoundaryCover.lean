import KernelAtlas.Rec7.Record2
import KernelAtlas.Rec7.Boundary
import KernelAtlas.Table.All
import KernelAtlas.Assembly
import KernelAtlas.Pack

/-! Record 7: `BoundaryCover` from the kernel checks of `Boundary.lean` (generated by `export_boundary.py`). -/

namespace NoFourMUBs.KernelAtlas.Rec7

open NoFourMUBs NoFourMUBs.KernelAtlas

set_option maxHeartbeats 0 in
theorem bdOK_ : bdMatch bd fq bars tq2 = true := by decide +kernel

/-- **The boundary cover of Record 7**, for any atlas `A` with `A l = cert` and targets `A (tg j)` with the
centres and radii of `bd.tg`. -/
theorem boundary {ι : Type*} (A : ι → RecordCert) (l : ι) (hl : A l = cert) (tg : ℕ → ι)
    (htP : ∀ j t, bd.tg[j]? = some t → (A (tg j)).P = Pmat t.pt)
    (htR : ∀ j t, bd.tg[j]? = some t → (t.Rt : ℝ) ≤ (A (tg j)).R) : Nonempty (BoundaryCover A l) :=
  boundaryK hl gOK_ tOK_ walk_ bdOK_ tg htP htR

/-- The atlas indices of the targets. -/
noncomputable def tgIdx : List ℕ := unpackL 6 83 0x3185f32cb2caaaa071f0bef2492492492492491041041041041048e38e38e38e38e38e38e38ebaebaebbaebaeba28a28a28adb6db46186186186186000000

set_option maxHeartbeats 0 in
theorem linkOK_ : linkOK bd Table.cen Table.rad Table.N tgIdx = true := by decide +kernel

/-- **The boundary cover of Record 7**, with the targets given by the atlas table. -/
theorem boundaryT {ι : Type*} (A : ι → RecordCert) (l : ι) (hl : A l = cert) (idx : ℕ → ι)
    (hP : ∀ t < Table.N, (A (idx t)).P = Pmat (pqL (Table.cen t)))
    (hR : ∀ t < Table.N, (Table.rad t : ℝ) ≤ (A (idx t)).R) : Nonempty (BoundaryCover A l) :=
  boundary_of_links linkOK_ idx hP hR (boundary A l hl)

end NoFourMUBs.KernelAtlas.Rec7
