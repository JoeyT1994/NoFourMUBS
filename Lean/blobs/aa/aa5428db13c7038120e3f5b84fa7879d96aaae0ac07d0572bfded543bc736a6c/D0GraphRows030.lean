import D0GraphData
set_option autoImplicit false
set_option maxRecDepth 1000000
set_option maxHeartbeats 0
namespace Mub6.Numerical.GraphKernel.D0Prototype
theorem orth_row_30 : ∀ j : Fin 120,
    IntegerIntervals.orthPossible 16 (zBoxes 30) (zBoxes j) = O 30 j := by
  decide +kernel
#print axioms orth_row_30
theorem unbiased_row_30 : ∀ j : Fin 120,
    IntegerIntervals.unbiasedPossible 16 (zBoxes 30) (zBoxes j) = U 30 j := by
  decide +kernel
#print axioms unbiased_row_30
