def rationalCentre (i : Fin 48) : RationalRay := rationalChart (centreSigns i) (centreSlopes i)

def exactCentre (i : Fin 48) : Vector := rationalRay (rationalCentre i)

def centreProbability (i j : Fin 48) : ℚ := rationalProbability (rationalCentre i) (rationalCentre j)

theorem exactCentre_formula (i : Fin 48) :
    exactCentre i = chartRay (centreSigns i) (fun j => (centreSlopes i j : ℝ)) :=
  rationalChart_eq_chartRay (centreSigns i) (centreSlopes i)

theorem all_centres_isRawUnitRay (i : Fin 48) : IsRawUnitRay (exactCentre i) :=
  rationalChart_isRawUnitRay (centreSigns i) (centreSlopes i)

theorem centreProbability_eq_complex (i j : Fin 48) :
    Complex.normSq (rawOverlap (exactCentre i) (exactCentre j)) / 36 =
      (centreProbability i j : ℝ) :=
  rawOverlap_rational_probability (rationalCentre i) (rationalCentre j)

#print axioms exactCentre_formula
#print axioms all_centres_isRawUnitRay
#print axioms centreProbability_eq_complex
end Mub6.Numerical.ClusterTube48
