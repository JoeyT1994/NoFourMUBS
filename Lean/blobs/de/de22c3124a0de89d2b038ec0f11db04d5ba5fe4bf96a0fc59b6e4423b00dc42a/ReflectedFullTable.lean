theorem productEta_root_input : ProductEta62Input=tableGG := by decide
theorem productChi_root_input : ProductChi152Input=tableChi := by decide

theorem tableFirst_exact : fastMul (ofInt 4) ProductEta62Output=tableFirst := by decide

theorem tableFullR_exact : mergeNormalize tableFirst (neg ProductChi152Output)=tableFullR := by decide

theorem eval_tableFullR (h : Exp4 → ℂ)
    (hz : h ⟨0,0,0,0⟩=1)
    (hm : ∀ a b, h (addExp a b)=h a*h b)
    (hc : ∀ e, h (negExp e)=star (h e)) :
    eval h tableFullR =
      complexCornerR (h ⟨1,0,0,0⟩) (h ⟨0,1,0,0⟩) (h ⟨0,0,1,0⟩) (h ⟨0,0,0,1⟩) := by
  rw [← eval_cornerPolynomial h hz hm hc]
  rw [← tableFullR_exact,eval_mergeNormalize,eval_neg,← tableFirst_exact,
    eval_fastMul h hm,eval_ofInt h hz,ProductEta62_eval h hm,ProductChi152_eval h hm,
    productEta_root_input,productChi_root_input,← tableGG_exact,eval_mul h hm,
    ← tableG_exact,← tableEta_exact,← tableChi_exact]
  rw [cornerPolynomial,eval_add,eval_neg,eval_mul h hm,eval_mul h hm,
    eval_mul h hm,eval_mul h hm,eval_ofInt h hz]
  simp only [Int.cast_ofNat]
  ring

theorem reflected_complexCornerR_eq_kernel (a b c d : ℂ) :
    complexCornerR a b c d=KernelLaurent.complexCornerR a b c d := rfl

theorem eval_phase_tableFullR (θ : Fin 4 → ℝ) :
    eval (phaseCharacter θ) tableFullR=
      KernelLaurent.complexCornerR
        (Complex.exp (Complex.I*(θ 0:ℂ))) (Complex.exp (Complex.I*(θ 1:ℂ)))
        (Complex.exp (Complex.I*(θ 2:ℂ))) (Complex.exp (Complex.I*(θ 3:ℂ))) := by
  rw [eval_tableFullR _ (phaseCharacter_zero θ) (phaseCharacter_add θ) (phaseCharacter_neg θ),
    reflected_complexCornerR_eq_kernel]
  simp [phaseCharacter,phaseDot]

