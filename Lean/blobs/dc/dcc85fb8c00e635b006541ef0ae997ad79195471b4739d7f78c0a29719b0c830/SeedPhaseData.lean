def octantEntry (n : Nat) : Pair := (octantArray[n]?).getD (0,0)

def quarterEntry (n : Nat) : Pair :=
  if n ≤ 228 then octantEntry n
  else let z := octantEntry (456-n); (z.2,z.1)

def rotateQuarter (q : Nat) (z : Pair) : Pair :=
  match q with
  | 0 => z
  | 1 => (-z.2,z.1)
  | 2 => (-z.1,-z.2)
  | _ => (z.2,-z.1)

def sparseEntry (n : Nat) : Pair :=
  rotateQuarter (n/456) (quarterEntry (n%456))

def tableEntry (n : Nat) : Pair := sparseEntry (n/120)

def centreEntry (label : Label) (i : Fin 5) : Pair :=
  (centreArray[5*label.val+i.val]?).getD (0,0)

