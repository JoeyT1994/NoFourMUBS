theorem residualIm_box : enclose (shiftedBoxes boxes shift) residualIm = residualImBox := by
  decide +kernel

theorem residualIm_sound (p : Variable → ℝ) (hp : ∀ i, Mem (boxes i) (p i)) :
    Mem residualImBox (evalReal p (residualPoly .vertical (1/1 : ℚ) (0/1 : ℚ) 2).im) := by
  rw [← residualIm_box]
  exact enclose_shifted_polynomial boxes shift p hp residualIm _ residualIm_identity

