  apply MvPolynomial.funext
  intro p
  rw [shiftedPolynomial_eval_rational]
  norm_num (config := { maxSteps := 1000000 }) [MvPolynomial.eval, residualIm, programPolynomial, termPolynomial, powersPolynomial, gPoly, sPoly, tPoly, rPoly, sideB, sideC, entryPoly, ComplexPoly.sub, ComplexPoly.const, ComplexPoly.real, ComplexPoly.add, ComplexPoly.mul, ComplexPoly.neg, ComplexPoly.conj, ComplexPoly.sq, ComplexPoly.normSq, shift_0, shift_1, shift_2, shift_3, shift_4, shift_5, shift_6, shift_7, shift_8, shift_9]
