import D0GraphData
set_option autoImplicit false
set_option maxRecDepth 1000000
set_option maxHeartbeats 0
namespace Mub6.Numerical.GraphKernel.D0Prototype
theorem orth_row_80 : ∀ j : Fin 120,
    IntegerIntervals.orthPossible 16 (zBoxes 80) (zBoxes j) = O 80 j := by
  decide +kernel
#print axioms orth_row_80
theorem unbiased_row_80 : ∀ j : Fin 120,
    IntegerIntervals.unbiasedPossible 16 (zBoxes 80) (zBoxes j) = U 80 j := by
  decide +kernel
#print axioms unbiased_row_80
