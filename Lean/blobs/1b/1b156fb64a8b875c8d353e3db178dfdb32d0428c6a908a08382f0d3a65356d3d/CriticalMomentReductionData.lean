def OrthogonalMoments (M : ℤ → ℤ → ℂ) : Prop :=
  M 0 0=6 ∧ M 1 0=0 ∧ M (-1) 0=0 ∧ M 0 1=0 ∧ M 0 (-1)=0 ∧
    M 1 (-1)=0 ∧ M (-1) 1=0

def momentMonomial (M : ℤ → ℤ → ℂ) (e : Exponent) : ℂ :=
  M (e 0) (e 3) * M (e 1) (e 4) * M (e 2) (e 5)

def rowValue (M : ℤ → ℤ → ℂ) (i : Fin 48) : ℂ :=
  ∑ j : Fin 48, (((cornerTerms i).1*(cornerTerms j).1 : ℤ) : ℂ) *
    momentMonomial M ((cornerTerms i).2+(cornerTerms j).2)

