/-- Split the high-degree polynomial proof from the later division step. -/
theorem even_numerator_p2_m4 (X Y z r : ℂ) :
    numerator_p2_m4 X Y z r=evenNumerator_p2_m4 X Y z (r^2) := by
  dsimp only [numerator_p2_m4,evenNumerator_p2_m4]
  ring

/-- Polynomial certificate for the quadratic reduction; no generic division
or numerical root assumption replaces the explicit complex relation. -/
theorem quadratic_p2_m4 (X Y z r : ℂ)
    (hX : X≠0) (hY : Y≠0) (hz : z≠0) (hDx : X-3*z-9≠0)
    (hDy : Y-3*z-9≠0) (hDz : X+Y+z^2+3*z≠0)
    (hq : Y*r^2= -X*(9-z^2-X-Y)) :
    numerator_p2_m4 X Y z r / denominator_p2_m4 X Y z r =
      reducedNumerator_p2_m4 X Y z r / reducedDenominator_p2_m4 X Y z r := by
  have hr : r^2= -X*(9-z^2-X-Y)/Y := by
    apply (eq_div_iff hY).mpr
    simpa only [mul_comm] using hq
  rw [even_numerator_p2_m4,hr]
  dsimp only [evenNumerator_p2_m4,denominator_p2_m4,reducedNumerator_p2_m4,reducedDenominator_p2_m4]
  field_simp [hX,hY,hz,hDx,hDy,hDz]
  <;> ring

/-- The same reduced moment, now connected to both complete reconstructed
sides and their actual Newton formulas. -/
theorem reduced_p2_m4 (X Y z r : ℂ)
    (hX : X≠0) (hY : Y≠0) (hz : z≠0) (hDx : X-3*z-9≠0)
    (hDy : Y-3*z-9≠0) (hDz : X+Y+z^2+3*z≠0)
    (hq : Y*r^2= -X*(9-z^2-X-Y)) :
    newton_p2_m4 (zeroSide X Y z r 1)+newton_p2_m4 (zeroSide X Y z r (-1)) =
      reducedNumerator_p2_m4 X Y z r / reducedDenominator_p2_m4 X Y z r := by
  rw [raw_p2_m4 X Y z r hX hz hDx hDy hDz]
  exact quadratic_p2_m4 X Y z r hX hY hz hDx hDy hDz hq
end
