theorem orth_row_110 : ∀ j : Fin 120,
    IntegerIntervals.orthPossible 16 (zBoxes 110) (zBoxes j) = O 110 j := by
  decide +kernel
#print axioms orth_row_110
theorem unbiased_row_110 : ∀ j : Fin 120,
    IntegerIntervals.unbiasedPossible 16 (zBoxes 110) (zBoxes j) = U 110 j := by
  decide +kernel
#print axioms unbiased_row_110
