theorem cached_eliminantA_eq (a b c d x : ℂ)
    (ha : a ≠ 0) (hb : b ≠ 0) (hc : c ≠ 0) (hd : d ≠ 0) :
    cachedEliminantA a b c d x =
      eliminantA (-(1+a+b)) (-(1+a⁻¹+b⁻¹))
        (-(1+c+d)) (-(1+c⁻¹+d⁻¹)) (-(1+c/a+d/b)) (-(1+a/c+b/d)) x := by
  rw [eliminantA_factorization]
  dsimp only [cachedEliminantA]
  field_simp [ha,hb,hc,hd]
  <;> ring

theorem cached_eliminantA_seed (p : Seed) (x : ℂ) :
    cachedEliminantA (p 0) (p 1) (p 2) (p 3) x =
      eliminantA (seedS p) (conj (seedS p)) (seedT p) (conj (seedT p))
        (seedRho p) (conj (seedRho p)) x := by
  rw [cached_eliminantA_eq _ _ _ _ _ (Circle.coe_ne_zero _) (Circle.coe_ne_zero _)
    (Circle.coe_ne_zero _) (Circle.coe_ne_zero _)]
  simp [seedS,seedT,seedRho,Complex.star_def,NoFourMUBs.Step1Geo.conj_circle,
    div_eq_mul_inv,mul_comm]

theorem cached_eliminantB_eq (a b c d x : ℂ)
    (ha : a ≠ 0) (hb : b ≠ 0) (hc : c ≠ 0) (hd : d ≠ 0) :
    cachedEliminantB a b c d x =
      eliminantB (-(1+a+b)) (-(1+a⁻¹+b⁻¹))
        (-(1+c+d)) (-(1+c⁻¹+d⁻¹)) (-(1+c/a+d/b)) (-(1+a/c+b/d)) x := by
  rw [eliminantB_coefficients]
  dsimp only [cachedEliminantB,eliminantBeta0,eliminantBeta1,eliminantBeta2,eliminantBeta3]
  field_simp [ha,hb,hc,hd]
  <;> ring

theorem cached_eliminantB_seed (p : Seed) (x : ℂ) :
    cachedEliminantB (p 0) (p 1) (p 2) (p 3) x =
      eliminantB (seedS p) (conj (seedS p)) (seedT p) (conj (seedT p))
        (seedRho p) (conj (seedRho p)) x := by
  rw [cached_eliminantB_eq _ _ _ _ _ (Circle.coe_ne_zero _) (Circle.coe_ne_zero _)
    (Circle.coe_ne_zero _) (Circle.coe_ne_zero _)]
  simp [seedS,seedT,seedRho,Complex.star_def,NoFourMUBs.Step1Geo.conj_circle,
    div_eq_mul_inv,mul_comm]

end NoFourMUBs.Step2.Reconstruction.BaseCoefficients
