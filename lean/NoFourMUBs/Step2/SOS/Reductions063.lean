theorem reductionSound2016 {H : CMatrix} (hH : IsHadamard H) :
    (1 : ℝ) * (NoFourMUBs.Step2.SOS.Semantics.code266).moment H =
      Integer.Sparse.eval reductionProjection2016 (momentVector H) := by
  have hc : coordinates (266 : Fin 1613) = (NoFourMUBs.Step2.SOS.Semantics.code266) := by decide +kernel
  have hm := congrArg (fun C : ExponentCode => C.moment H) hc
  simpa only [reductionProjection2016, Integer.Sparse.eval, List.map_cons, List.map_nil,
    List.sum_cons, List.sum_nil, Int.cast_one, one_mul,
    add_zero, momentVector] using hm.symm

