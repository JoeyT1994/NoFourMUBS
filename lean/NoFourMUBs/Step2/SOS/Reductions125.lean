        Integer.Sparse.eval (![reductionProjection3996, reductionProjection3667, reductionProjection3997, reductionProjection3999, reductionProjection3970] j) (momentVector H) := by
    intro j
    fin_cases j
    · have he : (mergeFirst reductionPivot4000 (0 : Fin 5)) = canonicalInput8030.entries := by
        ext u v; fin_cases u <;> fin_cases v <;> decide +kernel
