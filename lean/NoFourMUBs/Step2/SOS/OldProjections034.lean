def oldProjection2569 : Integer.Sparse (Fin 1613) := [(0, 1), (19, 12), (94, -12), (247, -16), (329, -144), (492, -144), (698, -16), (700, -16), (704, -16), (1251, -9)]

theorem oldProjectionSound2569 {H : CMatrix} (hH : IsHadamard H) :
    (288 : ℝ) * injectiveMoment H OAI.MUB6.Certificate.PairSemantics.node2569 =
      Integer.Sparse.eval oldProjection2569 (momentVector H) := by
  simpa only [Int.cast_one, Int.cast_ofNat] using
    (reuse_projection 288 oldEmbedding OAI.MUB6.Certificate.PairSemantics.value2569 oldProjection2569
      (by decide +kernel) (by decide +kernel)
      (momentVector H) (OAI.MUB6.Certificate.PairSemantics.momentVector H) (old_moment H)
      _ (OAI.MUB6.Certificate.PairSemantics.sound2569 hH))

