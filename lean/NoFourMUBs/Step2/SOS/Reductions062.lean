    · have he : (mergeFirst reductionPivot1986 (2 : Fin 4)) = canonicalInput8375.entries := by
        ext u v; fin_cases u <;> fin_cases v <;> decide +kernel
      change ((360 : ℤ) : ℝ) * injectiveMoment H (mergeFirst reductionPivot1986 (2 : Fin 4)) =
        Integer.Sparse.eval oldProjection1010 (momentVector H)
