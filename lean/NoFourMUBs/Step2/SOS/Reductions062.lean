theorem reductionSound1984 {H : CMatrix} (hH : IsHadamard H) :
    (1 : ℝ) * (NoFourMUBs.Step2.SOS.Semantics.code969).moment H =
      Integer.Sparse.eval reductionProjection1984 (momentVector H) := by
  have hc : coordinates (969 : Fin 1613) = (NoFourMUBs.Step2.SOS.Semantics.code969) := by decide +kernel
  have hm := congrArg (fun C : ExponentCode => C.moment H) hc
  simpa only [reductionProjection1984, Integer.Sparse.eval, List.map_cons, List.map_nil,
    List.sum_cons, List.sum_nil, Int.cast_one, one_mul,
    add_zero, momentVector] using hm.symm

