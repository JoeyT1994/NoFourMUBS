import NoFourMUBs.PRM.CoverageStripIdQF

/-! `momentPoly` split into groups of monomials (generated by
`lean/generators/stripid/gen_nonzero_part.py`). -/

noncomputable section

namespace NoFourMUBs.PRM.Coverage.StripId

open NoFourMUBs.Kronecker StripMoments

/-- Group 0 of the monomials of `momentPoly`. -/
def partC0 (M : ℤ × ℤ → ℂ) : ℂ :=
  1728 +
  (-2) * M ((-3), 0) * M (0, 2) * M (3, (-2)) +
  2 * M ((-3), 0) * M (0, 3) * M (3, (-3)) +
  2 * M ((-3), 0) * M (1, 1) * M (2, (-1)) +
  (-2) * M ((-3), 0) * M (1, 2) * M (2, (-2)) +
  12 * M ((-3), 0) * M (3, 0) +
  (-2) * M ((-3), 1) * M (0, 2) * M (3, (-3)) +
  (-2) * M ((-3), 1) * M (1, (-2)) * M (2, 1) +
  12 * M ((-3), 1) * M (3, (-1)) +
  (-2) * M ((-3), 2) * M (0, (-2)) * M (3, 0) +
  (-2) * M ((-3), 2) * M (1, 1) * M (2, (-3)) +
  12 * M ((-3), 2) * M (3, (-2)) +
  2 * M ((-3), 3) * M (0, (-3)) * M (3, 0) +
  (-2) * M ((-3), 3) * M (0, (-2)) * M (3, (-1)) +
  (-2) * M ((-3), 3) * M (1, (-3)) * M (2, 0) +
  2 * M ((-3), 3) * M (1, (-2)) * M (2, (-1)) +
  12 * M ((-3), 3) * M (3, (-3)) +
  (-2) * M ((-2), (-1)) * M ((-1), 2) * M (3, (-1)) +
  (-2) * M ((-2), (-1)) * M (0, 3) * M (2, (-2)) +
  12 * M ((-2), (-1)) * M (2, 1) +
  (-2) * M ((-2), 0) * M ((-1), 3) * M (3, (-3)) +
  6 * M ((-2), 0) * M (0, 2) * M (2, (-2)) +
  (-2) * M ((-2), 0) * M (0, 3) * M (2, (-3)) +
  (-48) * M ((-2), 0) * M (2, 0) +
  2 * M ((-2), 1) * M ((-1), (-1)) * M (3, 0) +
  2 * M ((-2), 1) * M ((-1), 2) * M (3, (-3)) +
  (-2) * M ((-2), 1) * M (1, (-3)) * M (1, 2) +
  (-2) * M ((-2), 1) * M (1, (-2)) * M (1, 1) +
  (-24) * M ((-2), 1) * M (2, (-1)) +
  (-2) * M ((-2), 2) * M ((-1), (-2)) * M (3, 0) +
  (-2) * M ((-2), 2) * M (0, (-3)) * M (2, 1) +
  6 * M ((-2), 2) * M (0, (-2)) * M (2, 0) +
  (-48) * M ((-2), 2) * M (2, (-2)) +
  (-2) * M ((-2), 3) * M ((-1), (-1)) * M (3, (-2)) +
  (-2) * M ((-2), 3) * M (0, (-3)) * M (2, 0) +
  12 * M ((-2), 3) * M (2, (-3)) +
  (-2) * M ((-1), (-2)) * M ((-1), 3) * M (2, (-1)) +
  12 * M ((-1), (-2)) * M (1, 2) +
  (-2) * M ((-1), (-1)) * M ((-1), 2) * M (2, (-1)) +
  2 * M ((-1), (-1)) * M (0, 3) * M (1, (-2)) +
  (-24) * M ((-1), (-1)) * M (1, 1) +
  2 * M ((-1), 2) * M (0, (-3)) * M (1, 1) +
  (-24) * M ((-1), 2) * M (1, (-2)) +
  12 * M ((-1), 3) * M (1, (-3)) +
  12 * M (0, (-3)) * M (0, 3) +
  (-48) * M (0, (-2)) * M (0, 2)
def partQ0 {n m : ℕ} {C : Ctx n m} (M : ℤ × ℤ → QF C) : QF C :=
  1728 +
  (-2) * M ((-3), 0) * M (0, 2) * M (3, (-2)) +
  2 * M ((-3), 0) * M (0, 3) * M (3, (-3)) +
  2 * M ((-3), 0) * M (1, 1) * M (2, (-1)) +
  (-2) * M ((-3), 0) * M (1, 2) * M (2, (-2)) +
  12 * M ((-3), 0) * M (3, 0) +
  (-2) * M ((-3), 1) * M (0, 2) * M (3, (-3)) +
  (-2) * M ((-3), 1) * M (1, (-2)) * M (2, 1) +
  12 * M ((-3), 1) * M (3, (-1)) +
  (-2) * M ((-3), 2) * M (0, (-2)) * M (3, 0) +
  (-2) * M ((-3), 2) * M (1, 1) * M (2, (-3)) +
