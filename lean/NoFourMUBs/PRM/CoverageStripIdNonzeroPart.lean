  2 * M ((-1), 2) * M (0, (-3)) * M (1, 1) +
  (-24) * M ((-1), 2) * M (1, (-2)) +
  12 * M ((-1), 3) * M (1, (-3)) +
  12 * M (0, (-3)) * M (0, 3) +
  (-48) * M (0, (-2)) * M (0, 2)

/-- Group 1 of the monomials of `momentPoly`. -/
def partC1 (M : ℤ × ℤ → ℂ) : ℂ :=
  (-1) * M ((-4), 2) * M (2, (-4)) * M (2, 2) +
  (-1) * M ((-2), (-2)) * M ((-2), 4) * M (4, (-2))
def partQ1 {n m : ℕ} {C : Ctx n m} (M : ℤ × ℤ → QF C) : QF C :=
  (-1) * M ((-4), 2) * M (2, (-4)) * M (2, 2) +
  (-1) * M ((-2), (-2)) * M ((-2), 4) * M (4, (-2))

/-- Group 2 of the monomials of `momentPoly`. -/
def partC2 (M : ℤ × ℤ → ℂ) : ℂ :=
  2 * M ((-4), 2) * M (2, (-3)) * M (2, 1) +
  1 * M ((-4), 2) * M (2, (-2)) * M (2, 0) +
  (-2) * M ((-4), 2) * M (2, (-1)) * M (2, (-1)) +
  2 * M ((-2), (-1)) * M ((-2), 3) * M (4, (-2)) +
  1 * M ((-2), 0) * M ((-2), 2) * M (4, (-2)) +
  (-2) * M ((-2), 1) * M ((-2), 1) * M (4, (-2))
def partQ2 {n m : ℕ} {C : Ctx n m} (M : ℤ × ℤ → QF C) : QF C :=
  2 * M ((-4), 2) * M (2, (-3)) * M (2, 1) +
  1 * M ((-4), 2) * M (2, (-2)) * M (2, 0) +
  (-2) * M ((-4), 2) * M (2, (-1)) * M (2, (-1)) +
  2 * M ((-2), (-1)) * M ((-2), 3) * M (4, (-2)) +
  1 * M ((-2), 0) * M ((-2), 2) * M (4, (-2)) +
  (-2) * M ((-2), 1) * M ((-2), 1) * M (4, (-2))

/-- Group 3 of the monomials of `momentPoly`. -/
def partC3 (M : ℤ × ℤ → ℂ) : ℂ :=
  2 * M ((-3), 1) * M (1, (-3)) * M (2, 2) +
  2 * M ((-2), (-2)) * M ((-1), 3) * M (3, (-1)) +
  1 * M ((-2), (-2)) * M (0, 2) * M (2, 0) +
  (-2) * M ((-2), (-2)) * M (1, 1) * M (1, 1) +
  1 * M ((-2), 0) * M (0, (-2)) * M (2, 2) +
  (-2) * M ((-1), (-1)) * M ((-1), (-1)) * M (2, 2)
def partQ3 {n m : ℕ} {C : Ctx n m} (M : ℤ × ℤ → QF C) : QF C :=
  2 * M ((-3), 1) * M (1, (-3)) * M (2, 2) +
  2 * M ((-2), (-2)) * M ((-1), 3) * M (3, (-1)) +
  1 * M ((-2), (-2)) * M (0, 2) * M (2, 0) +
  (-2) * M ((-2), (-2)) * M (1, 1) * M (1, 1) +
  1 * M ((-2), 0) * M (0, (-2)) * M (2, 2) +
  (-2) * M ((-1), (-1)) * M ((-1), (-1)) * M (2, 2)

/-- Group 4 of the monomials of `momentPoly`. -/
def partC4 (M : ℤ × ℤ → ℂ) : ℂ :=
  2 * M ((-3), 2) * M (1, 2) * M (2, (-4)) +
  1 * M ((-2), 2) * M (0, 2) * M (2, (-4)) +
  2 * M ((-2), 4) * M ((-1), (-2)) * M (3, (-2)) +
  1 * M ((-2), 4) * M (0, (-2)) * M (2, (-2)) +
  (-2) * M ((-2), 4) * M (1, (-2)) * M (1, (-2)) +
  (-2) * M ((-1), 2) * M ((-1), 2) * M (2, (-4))
def partQ4 {n m : ℕ} {C : Ctx n m} (M : ℤ × ℤ → QF C) : QF C :=
  2 * M ((-3), 2) * M (1, 2) * M (2, (-4)) +
  1 * M ((-2), 2) * M (0, 2) * M (2, (-4)) +
  2 * M ((-2), 4) * M ((-1), (-2)) * M (3, (-2)) +
  1 * M ((-2), 4) * M (0, (-2)) * M (2, (-2)) +
  (-2) * M ((-2), 4) * M (1, (-2)) * M (1, (-2)) +
  (-2) * M ((-1), 2) * M ((-1), 2) * M (2, (-4))

theorem momentPoly_parts (M : ℤ × ℤ → ℂ) : momentPoly M = partC0 M + partC1 M + partC2 M + partC3 M + partC4 M := by
  simp only [momentPoly, partC0, partC1, partC2, partC3, partC4]
  ring

set_option maxHeartbeats 1000000 in
theorem val_partQ {n m : ℕ} {C : Ctx n m} {ρ : Fin n → ℂ} {ζ : ℂ} (h : QF.Good C ρ ζ) (M : ℤ × ℤ → QF C) :
    (partQ0 M).val ρ ζ = partC0 (fun p => (M p).val ρ ζ) ∧ (partQ1 M).val ρ ζ = partC1 (fun p => (M p).val ρ ζ) ∧ (partQ2 M).val ρ ζ = partC2 (fun p => (M p).val ρ ζ) ∧ (partQ3 M).val ρ ζ = partC3 (fun p => (M p).val ρ ζ) ∧ (partQ4 M).val ρ ζ = partC4 (fun p => (M p).val ρ ζ) := by
  refine ⟨?_, ?_, ?_, ?_, ?_⟩ <;>
  · simp only [partQ0, partQ1, partQ2, partQ3, partQ4, partC0, partC1, partC2, partC3, partC4, QF.val_add h, QF.val_sub h, QF.val_mul h, QF.val_neg, QF.val_one', QF.val_ofNat']

end NoFourMUBs.PRM.Coverage.StripId
