  (-2) * M ((-2), (-1)) * M ((-1), 2) * M (3, (-1)) +
  (-2) * M ((-2), (-1)) * M (0, 3) * M (2, (-2)) +
  12 * M ((-2), (-1)) * M (2, 1) +
  (-2) * M ((-2), 0) * M ((-1), 3) * M (3, (-3)) +
  6 * M ((-2), 0) * M (0, 2) * M (2, (-2)) +
  (-2) * M ((-2), 0) * M (0, 3) * M (2, (-3)) +
  (-48) * M ((-2), 0) * M (2, 0) +
  2 * M ((-2), 1) * M ((-1), (-1)) * M (3, 0) +
  2 * M ((-2), 1) * M ((-1), 2) * M (3, (-3)) +
  (-2) * M ((-2), 1) * M (1, (-3)) * M (1, 2) +
  (-2) * M ((-2), 1) * M (1, (-2)) * M (1, 1) +
  (-24) * M ((-2), 1) * M (2, (-1)) +
  (-2) * M ((-2), 2) * M ((-1), (-2)) * M (3, 0) +
  (-2) * M ((-2), 2) * M (0, (-3)) * M (2, 1) +
  6 * M ((-2), 2) * M (0, (-2)) * M (2, 0) +
  (-48) * M ((-2), 2) * M (2, (-2)) +
  (-2) * M ((-2), 3) * M ((-1), (-1)) * M (3, (-2)) +
  (-2) * M ((-2), 3) * M (0, (-3)) * M (2, 0) +
  12 * M ((-2), 3) * M (2, (-3)) +
  (-2) * M ((-1), (-2)) * M ((-1), 3) * M (2, (-1)) +
  12 * M ((-1), (-2)) * M (1, 2) +
  (-2) * M ((-1), (-1)) * M ((-1), 2) * M (2, (-1)) +
