import NoFourMUBs.X.Main
import KernelAtlas.X.SC.XC

/-!
# Return X at radius `3/20`, hypothesis-free

The kernel-checked certificate `KernelAtlas.X.SC.core` (generated by `kernel_atlas/generators/x_stagec.py`; Stage C at
`F6` with return X's frame and radii, `σ`, `e₀`, `j₁` and the scalar conditions, see `KernelAtlas/X/StageC.lean`)
proves return X at the radius `ρ = 0.150001`, hence at `3/20`:

* `no_quartet_near_F6_r015`: no Hadamard `H` with `dph H ≤ 3/20` is a quartet edge;
* `no_quartet_near_F6_r015_phase`: the same for phase matrices, `‖h(Q − PF + 2πN)‖ ≤ 3/20`.
-/

open Matrix Hadamard6

namespace NoFourMUBs.X

open NoFourMUBs NoFourMUBs.SeedAtlas

lemma rho015_lt : (3 / 20 : ℝ) < (KernelAtlas.X.SC.rhoq : ℝ) := by
  unfold KernelAtlas.X.SC.rhoq; norm_num

/-- Return X at radius `ρ = 0.150001` (displacement form). -/
theorem core015 : ∀ δ : RMat6, IsHorizontal δ → frob δ ≤ (KernelAtlas.X.SC.rhoq : ℝ) →
    Hadamard6.IsHadamard (phaseMat (PF + δ)) → ¬ QuartetEdge (phaseMat (PF + δ)) :=
  KernelAtlas.X.SC.core

/-- **Return X at radius `3/20`**: no Hadamard matrix within horizontal phase distance `3/20` of `F6` is a quartet
edge. -/
theorem no_quartet_near_F6_r015 : ∀ H : Mat6, Hadamard6.IsHadamard H → dph H ≤ 3 / 20 → ¬ QuartetEdge H :=
  fun H hH hd => (no_quartet_of_cert core015).2 H hH (hd.trans_lt rho015_lt)

/-- **Return X at radius `3/20`, phase form**: `e^{iQ}` Hadamard with `‖h(Q − PF + 2πN)‖ ≤ 3/20` for some winding
`N` is not a quartet edge. -/
theorem no_quartet_near_F6_r015_phase : ∀ (Q : RMat6) (N : Matrix I6 I6 ℤ), frob (hor (Q - PF + wind N)) ≤ 3 / 20 →
    Hadamard6.IsHadamard (phaseMat Q) → ¬ QuartetEdge (phaseMat Q) :=
  fun Q N hQ => (no_quartet_of_cert core015).1 Q N (hQ.trans rho015_lt.le)

end NoFourMUBs.X
