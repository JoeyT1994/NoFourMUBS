import NoFourMUBs.X.Main
import KernelAtlas.X.SC175.XC

/-!
# Return X at radius `7/40`, hypothesis-free

The kernel-checked certificate `KernelAtlas.X.SC175.core` (generated by `kernel_atlas/generators/x_stagec.py`; Stage C at
`F6` with return X's frame and radii, `σ`, `e₀`, `j₁` and the scalar conditions, see `KernelAtlas/X/StageC.lean`)
proves return X at the radius `ρ = 0.175001`, hence at `7/40`:

* `no_quartet_near_F6_r0175`: no Hadamard `H` with `dph H ≤ 7/40` is a quartet edge;
* `no_quartet_near_F6_r0175_phase`: the same for phase matrices, `‖h(Q − PF + 2πN)‖ ≤ 7/40`.
-/

open Matrix Hadamard6

namespace NoFourMUBs.X

open NoFourMUBs NoFourMUBs.SeedAtlas

lemma rho0175_lt : (7 / 40 : ℝ) < (KernelAtlas.X.SC175.rhoq : ℝ) := by
  unfold KernelAtlas.X.SC175.rhoq; norm_num

/-- Return X at radius `ρ = 0.175001` (displacement form). -/
theorem core0175 : ∀ δ : RMat6, IsHorizontal δ → frob δ ≤ (KernelAtlas.X.SC175.rhoq : ℝ) →
    Hadamard6.IsHadamard (phaseMat (PF + δ)) → ¬ QuartetEdge (phaseMat (PF + δ)) :=
  KernelAtlas.X.SC175.core

/-- **Return X at radius `7/40`**: no Hadamard matrix within horizontal phase distance `7/40` of `F6` is a quartet
edge. -/
theorem no_quartet_near_F6_r0175 : ∀ H : Mat6, Hadamard6.IsHadamard H → dph H ≤ 7 / 40 → ¬ QuartetEdge H :=
  fun H hH hd => (no_quartet_of_cert core0175).2 H hH (hd.trans_lt rho0175_lt)

/-- **Return X at radius `7/40`, phase form**: `e^{iQ}` Hadamard with `‖h(Q − PF + 2πN)‖ ≤ 7/40` for some winding
`N` is not a quartet edge. -/
theorem no_quartet_near_F6_r0175_phase : ∀ (Q : RMat6) (N : Matrix I6 I6 ℤ), frob (hor (Q - PF + wind N)) ≤ 7 / 40 →
    Hadamard6.IsHadamard (phaseMat Q) → ¬ QuartetEdge (phaseMat Q) :=
  fun Q N hQ => (no_quartet_of_cert core0175).1 Q N (hQ.trans rho0175_lt.le)

end NoFourMUBs.X
