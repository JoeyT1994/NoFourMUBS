import NoFourMUBs.PRM.CoverageStripIdFormal
import NoFourMUBs.Identity.Fast

/-!
# Critical strip identities (I4): the moment formulas over `QF`, and packed polynomial data

Generated by `lean/generators/stripid/gen_qf.py` (the `momentPoly` text is copied from
`CoverageStripMomentData`); the agreement with the originals is proved here.

* `HalfQ`, `HalfQ.mom`, `momentPolyQ`: `HalfData`, `HalfData.mom` and `momentPoly` over the
  quadratic-extension fractions `QF C` of `NoFourMUBs.Identity.Frac`; `HalfQ.val_mom` and
  `val_momentPolyQ`: evaluation commutes with them.
* `QF.validR`: the fast kernel test on both components.
* `horner`: integer polynomials in three variables from nested coefficient lists (Horner form in
  variables `1` and `2`, the innermost coefficients univariate in variable `0`, packed in one natural
  number each).
-/

set_option linter.unusedSimpArgs false

noncomputable section

namespace NoFourMUBs.PRM.Coverage.StripId

open NoFourMUBs.Kronecker StripMoments

variable {n m : ℕ} {C : Ctx n m}

/-- The eighteen symbols of a half, over `QF C`. -/
structure HalfQ (C : Ctx n m) where
  s : QF C
  S : QF C
  t : QF C
  T : QF C
  r : QF C
  Q : QF C
  u : QF C
  v : QF C
  w : QF C
  U : QF C
  V : QF C
  W : QF C
  pi : QF C
  PI : QF C
  up : QF C
  vp : QF C
  UP : QF C
  VP : QF C

/-- `newtonHalf` over `QF C`. -/
def newtonHalfQ (s S t T r Q u v w wb pi up vp : QF C) (p : ℤ × ℤ) : QF C :=
  let m11 := s * t - pi
  let m2m1 := s * Q - up
  let mm12 := t * r - vp
  if p = (2, 0) then s ^ 2 - 2 * u * S
  else if p = (0, 2) then t ^ 2 - 2 * v * T
  else if p = (2, -2) then Q ^ 2 - 2 * w * r
  else if p = (1, 1) then m11
  else if p = (2, -1) then m2m1
  else if p = (-1, 2) then mm12
  else if p = (3, 0) then s ^ 3 - 3 * s * u * S + 3 * u
  else if p = (0, 3) then t ^ 3 - 3 * t * v * T + 3 * v
  else if p = (3, -3) then Q ^ 3 - 3 * Q * w * r + 3 * w
  else if p = (2, 1) then s * m11 - t * u * S + u * r
  else if p = (1, 2) then t * m11 - s * v * T + v * Q
  else if p = (3, -1) then s * m2m1 - Q * u * S + u * T
  else if p = (3, -2) then Q * m2m1 - s * w * r + w * t
  else if p = (-1, 3) then t * mm12 - r * v * T + v * S
  else if p = (-2, 3) then r * mm12 - t * wb * Q + wb * s
  else 0

/-- `HalfData.mom` over `QF C`. -/
def HalfQ.mom (d : HalfQ C) (p : ℤ × ℤ) : QF C :=
  let m := newtonHalfQ d.s d.S d.t d.T d.r d.Q d.u d.v d.w d.W d.pi d.up d.vp
  let b := newtonHalfQ d.S d.s d.T d.t d.Q d.r d.U d.V d.W d.w d.PI d.UP d.VP
  if p = (2, 2) then m (1, 1) ^ 2 - 2 * d.u * d.v * b (1, 1)
  else if p = (-2, -2) then b (1, 1) ^ 2 - 2 * d.U * d.V * m (1, 1)
  else if p = (4, -2) then m (2, -1) ^ 2 - 2 * d.u * d.w * b (2, -1)
  else if p = (-4, 2) then b (2, -1) ^ 2 - 2 * d.U * d.W * m (2, -1)
  else if p = (-2, 4) then m (-1, 2) ^ 2 - 2 * d.v * d.W * b (-1, 2)
  else if p = (2, -4) then b (-1, 2) ^ 2 - 2 * d.V * d.w * m (-1, 2)
  else if p ∈ halfDom then m p
  else b (-p.1, -p.2)

variable (ρ : Fin n → ℂ) (ζ : ℂ)

/-- The values. -/
def HalfQ.val (d : HalfQ C) : HalfData :=
  ⟨d.s.val ρ ζ, d.S.val ρ ζ, d.t.val ρ ζ, d.T.val ρ ζ, d.r.val ρ ζ, d.Q.val ρ ζ, d.u.val ρ ζ,
    d.v.val ρ ζ, d.w.val ρ ζ, d.U.val ρ ζ, d.V.val ρ ζ, d.W.val ρ ζ, d.pi.val ρ ζ, d.PI.val ρ ζ,
    d.up.val ρ ζ, d.vp.val ρ ζ, d.UP.val ρ ζ, d.VP.val ρ ζ⟩

variable {ρ ζ}

theorem QF.val_two : (2 : QF C).val ρ ζ = 2 := by rw [QF.val_ofNat]; norm_num
theorem QF.val_three : (3 : QF C).val ρ ζ = 3 := by rw [QF.val_ofNat]; norm_num
theorem QF.val_zero' : (0 : QF C).val ρ ζ = 0 := by rw [QF.val_ofNat]; norm_num
theorem QF.val_one' : (1 : QF C).val ρ ζ = 1 := by rw [QF.val_ofNat]; norm_num
theorem QF.val_ofNat' (k : ℕ) [k.AtLeastTwo] : (no_index (OfNat.ofNat k : QF C)).val ρ ζ = OfNat.ofNat k := by
  rw [QF.val_ofNat]; exact Nat.cast_ofNat

set_option maxHeartbeats 2000000 in
/-- **Evaluation commutes with the moment formulas.** -/
theorem HalfQ.val_mom (h : QF.Good C ρ ζ) (d : HalfQ C) {p : ℤ × ℤ} (hp : p ∈ usedMoments) :
    (d.mom p).val ρ ζ = (d.val ρ ζ).mom p := by
  simp only [usedMoments, List.mem_cons, List.mem_nil_iff, or_false] at hp
  rcases hp with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl |
    rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl |
    rfl | rfl | rfl | rfl <;>
  · simp (config := { decide := true }) only [HalfQ.mom, HalfData.mom, newtonHalfQ, newtonHalf, halfDom,
      ite_true, ite_false, List.mem_cons, List.mem_nil_iff, or_false, neg_neg, Int.reduceNeg, if_true,
      if_false]
    simp only [QF.val_add h, QF.val_sub h, QF.val_mul h, QF.val_pow h, QF.val_two, QF.val_three,
      HalfQ.val]

/-- `momentPoly` over `QF C`. -/
def momentPolyQ (M : ℤ × ℤ → QF C) : QF C :=@@MOMENTPOLY@@

set_option maxHeartbeats 2000000 in
theorem val_momentPolyQ (h : QF.Good C ρ ζ) (M : ℤ × ℤ → QF C) :
    (momentPolyQ M).val ρ ζ = momentPoly (fun p => (M p).val ρ ζ) := by
  simp only [momentPolyQ, QF.val_add h, QF.val_sub h, QF.val_mul h, QF.val_neg, QF.val_one',
    QF.val_ofNat']
  simp only [momentPoly]

/-! ### The fast test on both components -/

def qvalidR (x : QF C) (ns : ℕ) : Bool := x.x0.num.validR ns && x.x1.num.validR ns

theorem QF.val_eq_zero_of_validR {x : QF C} {ns : ℕ} (hx : qvalidR x ns = true) : x.val ρ ζ = 0 := by
  simp only [qvalidR, Bool.and_eq_true] at hx
  rw [QF.val, Frac.val_eq_zero_of_validR hx.1, Frac.val_eq_zero_of_validR hx.2]; ring

theorem QF.eq_of_validR (h : QF.Good C ρ ζ) {x y : QF C} {ns : ℕ} (hx : qvalidR (x - y) ns = true) :
    x.val ρ ζ = y.val ρ ζ := by
  have := QF.val_eq_zero_of_validR (ρ := ρ) (ζ := ζ) hx
  rw [QF.val_sub h] at this
  exact sub_eq_zero.1 this

/-! ### Packed polynomial data -/

/-- An integer from `W` bits: a sign bit and `W − 1` bits of absolute value. -/
def unpackInt (W c : ℕ) : ℤ :=
  if c % 2 = 1 then -((c / 2 % 2 ^ (W - 1) : ℕ) : ℤ) else ((c / 2 % 2 ^ (W - 1) : ℕ) : ℤ)

/-- `Σ_{i < len} cᵢ vⁱ` (Horner form), the `cᵢ` packed in `W`-bit fields of `code`, low first. -/
def hornerU (v : Circ 3) (W : ℕ) : ℕ → ℕ → Circ 3
  | 0, _ => 0
  | 1, code => Circ.const (unpackInt W (code % 2 ^ W))
  | len + 2, code => Circ.const (unpackInt W (code % 2 ^ W)) + v * hornerU v W (len + 1) (code / 2 ^ W)

/-- `Σᵢ cᵢ vⁱ` (Horner form) for circuits `cᵢ`. -/
def hornerL (v : Circ 3) : List (Circ 3) → Circ 3
  | [] => 0
  | [c] => c
  | c :: cs => c + v * hornerL v cs

/-- A polynomial in the variables `0, 1, 2` from nested data: `L[a][b] = (len, code)` holds the
coefficient of `x₁ᵃ x₂ᵇ`, a polynomial in `x₀` of `len` packed `W`-bit coefficients. -/
def horner (W : ℕ) (L : List (List (ℕ × ℕ))) : Circ 3 :=
  hornerL (Circ.var 1) (L.map fun row => hornerL (Circ.var 2) (row.map fun e => hornerU (Circ.var 0) W e.1 e.2))

end NoFourMUBs.PRM.Coverage.StripId
